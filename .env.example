# Copy to .env. `npm run setup` creates .env on first run if it is missing.
# Never commit .env. The Square token is read only on the server.

DATABASE_URL="file:./data/life-etc.db"

# Personal access token from Square Developer Console.
# Scopes: ITEMS_READ, ITEMS_WRITE, INVENTORY_READ, INVENTORY_WRITE, MERCHANT_PROFILE_READ
# Leave blank to use the clearly labeled demo catalog.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=production

# Required only for webhooks. Local development can use Sync Now instead.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Set both before exposing the app beyond this Mac.
APP_ACCESS_PASSWORD=
SESSION_SECRET=

# Optional bearer token for an external scheduler calling /api/square/sync
CRON_SECRET=
